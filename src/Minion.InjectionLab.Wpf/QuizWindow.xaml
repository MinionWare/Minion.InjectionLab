<Window x:Class="Minion.InjectionLab.Wpf.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:Minion.InjectionLab.Wpf.ViewModels"
        xmlns:core="clr-namespace:Minion.InjectionLab.Core.Models;assembly=Minion.InjectionLab.Core"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindowStyle}"
        Title="Quiz Mode" Height="820" Width="900" MinHeight="640" MinWidth="760"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Icon="Resources/Branding/AppIcon.png">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="Resources/Branding/AppIcon.png" Width="28" Height="28" Margin="0,0,10,0"/>
                <TextBlock Text="🏆 Quiz Mode" Style="{StaticResource Text.H1}" FontSize="20" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Devise your own attack — any payload that genuinely achieves the goal counts, not just one fixed answer."
                       Style="{StaticResource Text.Muted}" Margin="0,4,0,12"/>

            <Border Background="{DynamicResource Brush.Bg2}" CornerRadius="16" Padding="3" HorizontalAlignment="Left">
                <UniformGrid Columns="3">
                    <ToggleButton Content="Beginner" Style="{StaticResource Button.Segment}" Padding="20,8"
                                  IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Beginner, Mode=OneWay}"
                                  Command="{Binding SetDifficultyCommand}" CommandParameter="Beginner"/>
                    <ToggleButton Content="Intermediate" Style="{StaticResource Button.Segment}" Padding="20,8"
                                  IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Intermediate, Mode=OneWay}"
                                  Command="{Binding SetDifficultyCommand}" CommandParameter="Intermediate"/>
                    <ToggleButton Content="Expert" Style="{StaticResource Button.Segment}" Padding="20,8"
                                  IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Expert, Mode=OneWay}"
                                  Command="{Binding SetDifficultyCommand}" CommandParameter="Expert"/>
                </UniformGrid>
            </Border>
        </StackPanel>

        <!-- ================= MISSION ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding MissionsInTier}" Margin="0,0,0,10"
                              Visibility="{Binding HasMultipleMissions, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:QuizMission}">
                            <Button Content="{Binding Title}" Margin="0,0,8,0" Padding="12,6" FontSize="12"
                                    Command="{Binding DataContext.SelectMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding CurrentMission.Title, Mode=OneWay}" Style="{StaticResource Text.H2}" FontSize="18"/>
                <TextBlock Text="{Binding CurrentMission.Briefing, Mode=OneWay}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"/>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Background="{DynamicResource Brush.AccentMuted}">
                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                        <Run Text="🎯 Goal: " FontWeight="Bold"/>
                        <Run Text="{Binding CurrentMission.Goal, Mode=OneWay}"/>
                    </TextBlock>
                </Border>

                <!-- Field inputs -->
                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FieldValueViewModel}">
                            <StackPanel Margin="0,0,0,10" MaxWidth="480" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Field.Label}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource TextBox.Field}" FontFamily="{StaticResource Font.Code}"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="▶  Submit" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Padding="22,9"
                        FontSize="14" Command="{Binding SubmitCommand}"/>

                <!-- What actually runs -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="What actually runs" Style="{StaticResource Text.H2}"/>
                        <TabControl Margin="0,8,0,0" MinHeight="90">
                            <TabItem Header="SQL" Style="{StaticResource TabItem.Code}">
                                <Border Style="{StaticResource CodeBlock}" Margin="0,8,0,0">
                                    <TextBox Text="{Binding GeneratedSql, Mode=OneWay}" Style="{StaticResource TextBox.Selectable}"
                                             FontFamily="{StaticResource Font.Code}" FontSize="12" Foreground="{DynamicResource Brush.CodeText}"/>
                                </Border>
                            </TabItem>
                            <TabItem Header="C#" Style="{StaticResource TabItem.Code}">
                                <Border Style="{StaticResource CodeBlock}" Margin="0,8,0,0">
                                    <TextBox Text="{Binding GeneratedCSharp, Mode=OneWay}" Style="{StaticResource TextBox.Selectable}"
                                             FontFamily="{StaticResource Font.Code}" FontSize="12" Foreground="{DynamicResource Brush.CodeText}"/>
                                </Border>
                            </TabItem>
                            <TabItem Header="PowerShell" Style="{StaticResource TabItem.Code}">
                                <Border Style="{StaticResource CodeBlock}" Margin="0,8,0,0">
                                    <TextBox Text="{Binding GeneratedPowerShell, Mode=OneWay}" Style="{StaticResource TextBox.Selectable}"
                                             FontFamily="{StaticResource Font.Code}" FontSize="12" Foreground="{DynamicResource Brush.CodeText}"/>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- Outcome -->
                <Border Margin="0,16,0,0" CornerRadius="8" Padding="14" BorderThickness="1.5"
                        Visibility="{Binding LastOutcome, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Critical}"/>
                            <Setter Property="Background" Value="{DynamicResource Brush.Bg2}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastOutcome.Succeeded}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Blocked}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding LastOutcome.Headline, Mode=OneWay}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastOutcome.Succeeded}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blocked}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding LastOutcome.Detail, Mode=OneWay}" Style="{StaticResource Text.Body}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Discovered facts (Expert recon) -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                        Visibility="{Binding DiscoveredFacts, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="🔎 Discovered so far" Style="{StaticResource Text.H2}"/>
                        <ItemsControl ItemsSource="{Binding DiscoveredFacts}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode=OneTime}" FontFamily="{StaticResource Font.Code}" FontSize="12"
                                               Foreground="{DynamicResource Brush.Accent}" Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Hints -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                        Visibility="{Binding HasHints, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Stuck?" Style="{StaticResource Text.H2}"/>
                        <ItemsControl ItemsSource="{Binding RevealedHints}" Margin="0,4,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,2">
                                        <Run Text="Hint: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding Mode=OneTime}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="💡 Give me a hint" Command="{Binding RevealNextHintCommand}" IsEnabled="{Binding HasMoreHints}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Button Content="↺  Reset mission" Command="{Binding ResetCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
