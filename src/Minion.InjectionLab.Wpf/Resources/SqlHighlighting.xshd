<?xml version="1.0"?>
<SyntaxDefinition name="SQL" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <!-- A minimal T-SQL definition — just enough to make comments, strings, parameters and
       keywords read clearly in the app's code panes. Not a complete SQL grammar. -->

  <Color name="Comment" foreground="#6A9955" exampleText="-- comment"/>
  <Color name="String" foreground="#CE9178" exampleText="'literal'"/>
  <Color name="Keyword" foreground="#569CD6" fontWeight="bold" exampleText="SELECT"/>
  <Color name="Parameter" foreground="#9CDCFE" exampleText="@UserName"/>
  <Color name="Number" foreground="#B5CEA8" exampleText="42"/>

  <RuleSet>
    <Span color="Comment" begin="--"/>
    <Span color="Comment" multiline="true">
      <Begin>/\*</Begin>
      <End>\*/</End>
    </Span>

    <Span color="String">
      <Begin>'</Begin>
      <End>'</End>
    </Span>

    <Rule color="Parameter">
      @[\w]+
    </Rule>

    <Rule color="Number">
      \b0[xX][0-9a-fA-F]+\b|\b\d+(\.\d+)?\b
    </Rule>

    <Keywords color="Keyword">
      <Word>SELECT</Word>
      <Word>FROM</Word>
      <Word>WHERE</Word>
      <Word>AND</Word>
      <Word>OR</Word>
      <Word>NOT</Word>
      <Word>IS</Word>
      <Word>NULL</Word>
      <Word>LIKE</Word>
      <Word>IN</Word>
      <Word>EXISTS</Word>
      <Word>INSERT</Word>
      <Word>INTO</Word>
      <Word>VALUES</Word>
      <Word>UPDATE</Word>
      <Word>SET</Word>
      <Word>DELETE</Word>
      <Word>JOIN</Word>
      <Word>INNER</Word>
      <Word>LEFT</Word>
      <Word>RIGHT</Word>
      <Word>OUTER</Word>
      <Word>ON</Word>
      <Word>GROUP</Word>
      <Word>BY</Word>
      <Word>ORDER</Word>
      <Word>HAVING</Word>
      <Word>UNION</Word>
      <Word>ALL</Word>
      <Word>DISTINCT</Word>
      <Word>TOP</Word>
      <Word>AS</Word>
      <Word>EXEC</Word>
      <Word>EXECUTE</Word>
      <Word>DECLARE</Word>
      <Word>CREATE</Word>
      <Word>ALTER</Word>
      <Word>DROP</Word>
      <Word>TABLE</Word>
      <Word>PROCEDURE</Word>
      <Word>FUNCTION</Word>
      <Word>BEGIN</Word>
      <Word>END</Word>
      <Word>IF</Word>
      <Word>ELSE</Word>
      <Word>WHILE</Word>
      <Word>RETURN</Word>
      <Word>WAITFOR</Word>
      <Word>DELAY</Word>
      <Word>CONVERT</Word>
      <Word>CAST</Word>
      <Word>VARCHAR</Word>
      <Word>NVARCHAR</Word>
      <Word>INT</Word>
      <Word>BIT</Word>
      <Word>SP_EXECUTESQL</Word>
    </Keywords>
  </RuleSet>
</SyntaxDefinition>
