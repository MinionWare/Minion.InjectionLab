<Window x:Class="Minion.InjectionLab.Wpf.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindowStyle}"
        Title="What's New"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="What's New in " Style="{StaticResource Text.H2}" FontSize="16"/>
            <TextBlock x:Name="TxVersion" Style="{StaticResource Text.H2}" FontSize="16" Foreground="{DynamicResource Brush.Blocked}"/>
        </StackPanel>
        <TextBlock Text="Here's what changed in this release:" Style="{StaticResource Text.Muted}" Margin="0,0,0,16"/>

        <!-- Feature list -->
        <ItemsControl x:Name="FeatureList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Blocked}"
                                 VerticalAlignment="Center" Margin="0,5,10,0"/>
                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" MaxWidth="350"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Download Now" Style="{StaticResource Button.Primary}"
                    Padding="16,7" Margin="0,0,10,0" Click="Download_Click"/>
            <Button Content="Later" Style="{StaticResource Button.Ghost}" Padding="16,7" Click="Later_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
