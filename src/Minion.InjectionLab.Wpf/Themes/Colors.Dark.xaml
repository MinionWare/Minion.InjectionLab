<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="Color.Bg0">#0F1115</Color>
    <Color x:Key="Color.Bg1">#161922</Color>
    <Color x:Key="Color.Bg2">#1E222D</Color>
    <Color x:Key="Color.Border">#2B313F</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#E8EAED</Color>
    <Color x:Key="Color.TextSecondary">#9AA3B2</Color>
    <Color x:Key="Color.TextMuted">#6B7384</Color>

    <!-- Brand / accent -->
    <Color x:Key="Color.Accent">#5AA7FF</Color>
    <Color x:Key="Color.AccentMuted">#2E4E78</Color>

    <!-- Severity -->
    <Color x:Key="Color.Critical">#FF5C6C</Color>
    <Color x:Key="Color.Warning">#FFB454</Color>
    <Color x:Key="Color.Blocked">#3DD68C</Color>
    <Color x:Key="Color.Info">#6B9EFF</Color>

    <!-- Code highlighting (generated SQL view) -->
    <Color x:Key="Color.CodeBg">#10131A</Color>
    <Color x:Key="Color.CodeText">#D4D8E0</Color>
    <Color x:Key="Color.CodeInjected">#FF8A80</Color>
    <Color x:Key="Color.CodeKeyword">#5AA7FF</Color>

</ResourceDictionary>
