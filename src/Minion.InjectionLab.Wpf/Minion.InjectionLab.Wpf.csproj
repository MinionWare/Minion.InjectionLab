<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Minion.InjectionLab.Core\Minion.InjectionLab.Core.csproj" />
    <!-- UpdateCheckService/IJSONHandler now live centrally here instead of being copy-pasted
         per app: see Minion.Licensing's own docs for why. -->
    <ProjectReference Include="..\..\..\Minion.Licensing\Minion.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SqlHighlighting.xshd" />
    <EmbeddedResource Include="Resources\CSharpHighlighting.xshd" />
    <EmbeddedResource Include="Resources\PowerShellHighlighting.xshd" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Branding\AppIcon.png" />
    <Resource Include="Resources\Branding\MinionwareWordmark.png" />
  </ItemGroup>

  <!-- Same convention as Minion.Agent.Wpf: a real, independently-editable file next
       to the exe, not baked into the assembly, so UpdateManifestUrl can change
       without a recompile. -->
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\Branding\AppIcon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
