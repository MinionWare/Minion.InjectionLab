<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Minion.InjectionLab.Core\Minion.InjectionLab.Core.csproj" />
    <!-- UpdateCheckService/IJSONHandler now live centrally here instead of being copy-pasted
         per app: see Minion.Licensing's own docs for why. -->
    <ProjectReference Include="..\..\..\Minion.Licensing\Minion.Licensing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SqlHighlighting.xshd" />
    <EmbeddedResource Include="Resources\CSharpHighlighting.xshd" />
    <EmbeddedResource Include="Resources\PowerShellHighlighting.xshd" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Branding\AppIcon.png" />
    <Resource Include="Resources\Branding\MinionwareWordmark.png" />
  </ItemGroup>

  <!-- Neon HUD redesign fonts (Google Fonts, SIL OFL) -->
  <ItemGroup>
    <Resource Include="Resources\Fonts\ChakraPetch-Medium.ttf" />
    <Resource Include="Resources\Fonts\ChakraPetch-SemiBold.ttf" />
    <Resource Include="Resources\Fonts\ChakraPetch-Bold.ttf" />
    <Resource Include="Resources\Fonts\Sora-Regular.ttf" />
    <Resource Include="Resources\Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="Resources\Fonts\JetBrainsMono-Italic.ttf" />
  </ItemGroup>

  <!-- Bundled HelpServer: a self-contained copy of D:\GitHub\HelpServer's own release build, plus
       a copy of this app's help/ content (that folder stays the source of truth — update both,
       or re-run the copy, when help content changes) and a config scoped to just this app's docs
       (not the shared team instance's sites/data). The app launches this exe itself on demand;
       see HelpClient. HelpServer\HelpServer.exe is gitignored (124MB) — publish it locally before
       building for distribution: from D:\GitHub\HelpServer\HelpServer, run
       `dotnet publish -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true`
       and copy the resulting HelpServer.exe here. -->
  <ItemGroup>
    <Content Include="HelpServer\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\Branding\AppIcon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
