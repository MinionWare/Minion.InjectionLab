<Window x:Class="Minion.InjectionLab.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minion.InjectionLab.Wpf"
        xmlns:vm="clr-namespace:Minion.InjectionLab.Wpf.ViewModels"
        xmlns:behaviors="clr-namespace:Minion.InjectionLab.Wpf.Behaviors"
        xmlns:core="clr-namespace:Minion.InjectionLab.Core.Models;assembly=Minion.InjectionLab.Core"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindowStyle}"
        Title="Minion.InjectionLab" Height="900" Width="1420" MinHeight="680" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Icon="Resources/Branding/AppIcon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ================= MENU BAR ================= -->
        <Menu Grid.Row="0" Background="{DynamicResource Brush.Bg0}"
              Foreground="{DynamicResource Brush.TextSecondary}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle theme" Command="{Binding ToggleThemeCommand}"/>
                <MenuItem Header="Quiz mode" Click="QuizButton_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Feature list" Click="HelpButton_Click"/>
                <MenuItem Header="Show tutorial" Click="TutorialButton_Click"/>
                <Separator/>
                <MenuItem Header="About Minion.InjectionLab" Click="AboutMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Minionware">
                <MenuItem Header="minionware.net" Click="MinionwareLogo_Click"/>
                <MenuItem Header="Other products (coming soon)" IsEnabled="False"/>
            </MenuItem>
        </Menu>

        <!-- ================= UPDATE BANNER =================
             Collapsed until MainWindow.xaml.cs's startup update check finds a newer,
             non-skipped version. See CheckForUpdatesAsync. -->
        <Border x:Name="UpdateBanner" Grid.Row="1"
                Background="{DynamicResource Brush.AccentMuted}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,0,1"
                Visibility="Collapsed" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateBannerText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="UpdateBannerWhatsNewButton" Grid.Column="1" Content="What's New" Style="{StaticResource Button.Ghost}"
                        Click="UpdateBannerWhatsNew_Click" Margin="8,0,0,0"/>
                <Button x:Name="UpdateBannerDownloadButton" Grid.Column="2" Content="Download" Style="{StaticResource Button.Primary}"
                        Click="UpdateBannerDownload_Click" Margin="8,0,0,0"/>
                <Button x:Name="UpdateBannerDismissButton" Grid.Column="3" Content="✕" Style="{StaticResource Button.Ghost}"
                        Click="UpdateBannerDismiss_Click" Margin="8,0,0,0" ToolTip="Dismiss — won't ask again for this version"/>
            </Grid>
        </Border>

        <!-- ================= TOP BAR (hidden on Welcome) ================= -->
        <Border Grid.Row="2" Height="58"
                Background="{DynamicResource Brush.Bg1}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <DockPanel Margin="26,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Back to the welcome screen" Command="{Binding GoHomeCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Brush.Bg2}" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="Resources/Branding/AppIcon.png" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <TextBlock Text="INJECTIONLAB" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Hud}" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="22,0,22,0" VerticalAlignment="Center">
                    <ToggleButton Content="MISSIONS" Style="{StaticResource Button.NavItem}"
                                  IsChecked="{Binding IsMissionsAreaActive, Mode=OneWay}" Command="{Binding BrowseCatalogCommand}"/>
                    <ToggleButton Content="TRAINING" Style="{StaticResource Button.NavItem}" Click="TutorialButton_Click"
                                  IsChecked="{Binding IsTraining, Mode=OneWay}"/>
                    <ToggleButton Content="QUIZ" Style="{StaticResource Button.NavItem}" Click="QuizButton_Click"
                                  IsChecked="{Binding IsQuiz, Mode=OneWay}"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontFamily="{StaticResource Font.Code}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding HasSelectedAttack, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Run Text="{Binding SelectedAttack.Scenario.Category, Converter={StaticResource CategoryDisplayConverter}, Mode=OneWay}"/>
                    <Run Text=" › "/>
                    <Run Text="{Binding SelectedAttack.Scenario.Title, Mode=OneWay}"/>
                </TextBlock>

                <Button Content="SKIP TRAINING ✕" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Button.Ghost}"
                        Margin="0,0,16,0" Command="{Binding Tutorial.CloseCommand}"
                        Visibility="{Binding IsTraining, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button Content="END QUIZ ✕" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Button.Ghost}"
                        Margin="0,0,16,0" Command="{Binding Quiz.QuitCommand}"
                        Visibility="{Binding IsQuiz, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="{StaticResource Font.Code}" FontSize="15"
                           Margin="0,0,16,0" Foreground="{DynamicResource Brush.Blocked}"
                           Visibility="{Binding IsQuiz, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Run Text="SCORE "/><Run Text="{Binding Quiz.Score, Mode=OneWay}"/><Run Text=" / 6"/>
                </TextBlock>

                <Button x:Name="DifficultyChipButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Style="{StaticResource Button.DifficultyChip}" Cursor="Hand" Click="DifficultyChip_Click"
                        Visibility="{Binding IsTrainingOrQuiz, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Difficulty}"/>
                        <TextBlock Text=" ▾" Margin="2,0,0,0"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="DifficultyChipMenu">
                            <MenuItem Header="Beginner" Command="{Binding SetDifficultyCommand}" CommandParameter="Beginner"/>
                            <MenuItem Header="Intermediate" Command="{Binding SetDifficultyCommand}" CommandParameter="Intermediate"/>
                            <MenuItem Header="Expert" Command="{Binding SetDifficultyCommand}" CommandParameter="Expert"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <StackPanel DockPanel.Dock="Right" Width="170" Margin="0,0,22,0" VerticalAlignment="Center"
                            Visibility="{Binding IsTrainingOrQuiz, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="CLEARED" FontFamily="{StaticResource Font.Code}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0"/>
                        <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="10" FontWeight="Bold">
                            <Run Text="{Binding ClearedCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding AttackCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Width="170" Height="4" CornerRadius="2" Background="{DynamicResource Brush.Bg2}" Margin="0,5,0,0">
                        <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource Brush.GradientProgress}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                    <Binding Path="ClearedCount"/>
                                    <Binding Path="AttackCount"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= WELCOME SCREEN ================= -->
        <!-- DataContext here is still the MainViewModel (nothing below overrides it). -->
        <Grid Grid.Row="2" Grid.RowSpan="2"
              Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{DynamicResource Brush.Bg0}">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,28,0">
                <Button Content="QUIZ" Style="{StaticResource Button.CornerLink}" Margin="0,0,18,0" Click="QuizButton_Click"/>
                <Button Content="HELP" Style="{StaticResource Button.CornerLink}" Margin="0,0,18,0" Click="HelpButton_Click"/>
                <Button Content="◐ THEME" Style="{StaticResource Button.CornerLink}" Command="{Binding ToggleThemeCommand}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Margin="0,34,0,34">

                <Grid x:Name="WelcomeIconGrid" HorizontalAlignment="Center" Width="440" Height="440" Margin="0,70,0,0">
                    <Ellipse x:Name="WelcomeGlow" Width="420" Height="420" Fill="{DynamicResource Brush.NeonViolet}" Opacity="0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="WelcomeGlowScale" ScaleX="0.4" ScaleY="0.4"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                            <BlurEffect Radius="80"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Image x:Name="WelcomeMascot" Source="Resources/Branding/AppIcon.png" Width="330" Height="330"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="WelcomeMascotScale" ScaleX="0.3" ScaleY="0.3"/>
                                <TranslateTransform x:Name="WelcomeMascotFloat" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                        <Image.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="24" Opacity="0.65"/>
                        </Image.Effect>
                    </Image>
                </Grid>

                <StackPanel x:Name="WelcomeFromRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <ScaleTransform x:Name="WelcomeFromRowScale" ScaleX="0.3" ScaleY="0.3"/>
                    </StackPanel.RenderTransform>
                    <TextBlock Text="FROM" FontFamily="{StaticResource Font.Code}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="WelcomeLogoButton" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="minionware.net" Click="MinionwareLogo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="Resources/Branding/MinionwareWordmark.png" Stretch="Uniform" Height="44"/>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="WelcomeTitleStack" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="WelcomeTitleStackTranslate" Y="14"/>
                    </StackPanel.RenderTransform>
                    <TextBlock Text="INJECTIONLAB" FontFamily="{StaticResource Font.Hud}" FontSize="64" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,14,0,0">
                        <TextBlock.Foreground>
                            <LinearGradientBrush x:Name="WelcomeWordmarkBrush" StartPoint="0,0.5" EndPoint="1,0.5" SpreadMethod="Repeat">
                                <LinearGradientBrush.Transform>
                                    <TranslateTransform x:Name="WelcomeWordmarkShimmer" X="0"/>
                                </LinearGradientBrush.Transform>
                                <GradientStop Color="#FF3B5C" Offset="0"/>
                                <GradientStop Color="#C25CFF" Offset="0.5"/>
                                <GradientStop Color="#4D8BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="SQL injection, attack by attack — see exactly how, and exactly why the fix works."
                               FontFamily="{StaticResource Font.Body}" FontSize="16" Foreground="#AEB5C3" Margin="0,14,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="WelcomeCtaRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="WelcomeCtaRowTranslate" Y="14"/>
                    </StackPanel.RenderTransform>
                    <Button Style="{StaticResource Button.GradientCta}" Margin="0,0,14,0" Click="TutorialButton_Click">
                        <StackPanel>
                            <TextBlock Text="START TRAINING" FontFamily="{StaticResource Font.Hud}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="9 steps · about 5 minutes" FontFamily="{StaticResource Font.Body}" FontSize="11.5"
                                       Opacity="0.85" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.OutlineBlue}" Command="{Binding BrowseCatalogCommand}">
                        <StackPanel>
                            <TextBlock Text="MISSION SELECT" FontFamily="{StaticResource Font.Hud}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock FontFamily="{StaticResource Font.Body}" FontSize="11.5" Foreground="#AEB5C3" HorizontalAlignment="Center" Margin="0,3,0,0">
                                <Run Text="{Binding AttackCount, Mode=OneWay}"/><Run Text=" attacks · 7 sectors"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border x:Name="WelcomeSafetyPill" HorizontalAlignment="Center" Margin="0,32,0,0" Opacity="0"
                        CornerRadius="30" Padding="18,10" BorderThickness="1" BorderBrush="#1F3B2E" Background="#0F3DD68C">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="WelcomeSafetyPillTranslate" Y="14"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Blocked}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{DynamicResource Color.Blocked}" ShadowDepth="0" BlurRadius="10" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock FontFamily="{StaticResource Font.Body}" FontSize="12.5" Foreground="#AEB5C3" TextWrapping="Wrap" MaxWidth="460">
                            <Run Text="This app never touches a real database." FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <Run Text=" Every query and every &quot;leaked row&quot; is simulated text. Safe to run anywhere."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= MISSION SELECT ================= -->
        <Grid Grid.Row="3" Visibility="{Binding IsMissionSelect, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sectors column -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel Margin="26,24,18,24">
                    <TextBlock DockPanel.Dock="Top" Text="SECTORS" FontFamily="{StaticResource Font.Code}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,14"/>
                    <ListBox ItemsSource="{Binding Sectors}" SelectedIndex="{Binding SelectedSectorIndex}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SectorCard}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SectorViewModel}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Hud}" FontSize="13.5" FontWeight="Bold"
                                                   Foreground="{Binding Category, Converter={StaticResource CategoryToSectorBrushConverter}}"
                                                   HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,50,0"/>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="{StaticResource Font.Code}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}">
                                            <Run Text="{Binding ClearedCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Border Width="246" Height="3" CornerRadius="1.5" Background="{DynamicResource Brush.Bg2}" Margin="0,8,0,0">
                                        <Border HorizontalAlignment="Left" CornerRadius="1.5"
                                                Background="{Binding Category, Converter={StaticResource CategoryToSectorBrushConverter}}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}" ConverterParameter="246">
                                                    <Binding Path="ClearedCount"/>
                                                    <Binding Path="TotalCount"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Missions area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding CurrentSector}">
                <StackPanel Margin="30,20,30,24">
                    <Grid>
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"
                                       Foreground="{Binding Category, Converter={StaticResource CategoryToSectorBrushConverter}}">
                                <Run Text="SECTOR "/><Run Text="{Binding SectorNumber, StringFormat=D2}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Hud}" FontSize="32" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} scenarios in this sector.'}"
                                       FontFamily="{StaticResource Font.Body}" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="{StaticResource Font.Code}" FontSize="11"
                                   FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}">
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" MISSIONS"/>
                        </TextBlock>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Missions}" Margin="0,18,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttackViewModel}">
                                <Button Margin="0,0,12,12"
                                        Command="{Binding DataContext.SelectMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MissionCard}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.NeonRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding MissionCode}" FontFamily="{StaticResource Font.Code}" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Left"
                                                       Foreground="{Binding Scenario.Category, Converter={StaticResource CategoryToSectorBrushConverter}}"/>
                                            <Border HorizontalAlignment="Right" Background="#1A9AA3B2">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cleared">
                                                                <Setter Property="Background" Value="#1E3DD68C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                <Setter Property="Background" Value="#24FF2D55"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.NeonRed}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="NEW" FontFamily="{StaticResource Font.Code}" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.TextSecondary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cleared">
                                                                    <Setter Property="Text" Value="CLEARED"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blocked}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                    <Setter Property="Text" Value="IN PROGRESS"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.NeonRedLabel}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Scenario.Title}" FontFamily="{StaticResource Font.Hud}" FontSize="16" FontWeight="Bold"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock Text="{Binding Scenario.Premise}" FontFamily="{StaticResource Font.Body}" FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" MaxHeight="34"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= MISSION (2c/2d) ================= -->
        <Grid Grid.Row="3" Visibility="{Binding IsMission, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid DataContext="{Binding SelectedAttack}">
            <!-- Whole screen scrolls as one unit. VerticalScrollBarVisibility is forced to Visible
                 (not Auto) so the scrollbar track always renders, even when the content happens to
                 fit — Auto was apparently not reading as "this scrolls" at a glance. -->
            <ScrollViewer VerticalScrollBarVisibility="Visible">
            <StackPanel Margin="26,18,26,24">

                <!-- Title row -->
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MissionCode}" FontFamily="{StaticResource Font.Code}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.NeonRedLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding Scenario.Title}" FontFamily="{StaticResource Font.Hud}" FontSize="24" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton Content="◎ CHALLENGE" Style="{StaticResource Button.TitleToggle.Challenge}"
                                      IsChecked="{Binding IsChallengeMode}" Margin="0,0,8,0"/>
                        <ToggleButton Content="▤ INTEL" Style="{StaticResource Button.TitleToggle.Intel}"
                                      IsChecked="{Binding IsIntelOpen}" Margin="0,0,14,0"/>
                        <Button Content="↺ RESET" Style="{StaticResource Button.Ghost}" Command="{Binding ResetScenarioCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Objective banner (Challenge mode) -->
                <Border Margin="0,0,0,14" CornerRadius="14" Padding="20,18" BorderThickness="1" BorderBrush="#3A2E1A"
                        Visibility="{Binding IsChallengeMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#17FFB454" Offset="0"/>
                            <GradientStop Color="#03FFB454" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="OBJECTIVE" FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Warning}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Scenario.ChallengeGoal}" FontFamily="{StaticResource Font.Hud}" FontSize="22" FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource Button.ObjectiveSolid}" Margin="0,0,8,0"
                                        Command="{Binding RevealNextHintCommand}" IsEnabled="{Binding HasMoreHints}">
                                    <TextBlock>
                                        <Run Text="REVEAL HINT · "/><Run Text="{Binding HintBudget, Mode=OneWay}"/>
                                        <Run Text="-"/><Run Text="{Binding RevealedHintCount, Mode=OneWay}"/><Run Text=" LEFT"/>
                                    </TextBlock>
                                </Button>
                                <Button Content="SHOW ANSWER" Style="{StaticResource Button.ObjectiveOutline}"
                                        Command="{Binding RevealAnswerCommand}" IsEnabled="{Binding CanRevealAnswer}"
                                        ToolTip="Not available on Expert"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <ItemsControl ItemsSource="{Binding RevealedHints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,7" BorderThickness="1"
                                                BorderBrush="#5A4520" Background="#0FFFB454">
                                            <TextBlock FontFamily="{StaticResource Font.Body}" FontSize="13" TextWrapping="Wrap">
                                                <Run Text="HINT: " FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}"/>
                                                <Run Text="{Binding Mode=OneTime}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Margin="0,0,0,7" CornerRadius="8" Padding="12,8" BorderThickness="1" BorderBrush="#1F2433"
                                    Visibility="{Binding HasMoreHints, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Locked" FontFamily="{StaticResource Font.Code}" FontSize="11" Foreground="#4A5066"/>
                            </Border>
                            <Border CornerRadius="8" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource Brush.NeonRed}"
                                    Background="#1AFF2D55" Visibility="{Binding IsAnswerRevealed, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="ANSWER" FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.NeonRedLabel}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Scenario.ChallengeAnswer, Mode=OneTime}" FontFamily="{StaticResource Font.Code}"
                                               FontSize="14" Foreground="{DynamicResource Brush.UserInputText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main grid: Threat Route | Form + Code | Verdict/Intel -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Threat Route -->
                    <StackPanel Grid.Column="0" Visibility="{Binding HasDecisionPaths, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Image Source="Resources/Branding/AppIcon.png" Width="170" Height="170" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Image.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="10" Opacity="0.5"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="THREAT ROUTE · LIVE" FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding Scenario.DecisionPaths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:DecisionPathDef}">
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource ThreatRouteRow}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource PathActiveConverter}">
                                                                <Binding Path="Key"/>
                                                                <Binding Path="DataContext.ActivePathKey" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Setter Property="BorderBrush" Value="{Binding Kind, Converter={StaticResource PathKindToBrushConverter}}"/>
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Bg1}"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect ShadowDepth="0" BlurRadius="22" Opacity="0.35"
                                                                                  Color="{Binding Kind, Converter={StaticResource PathKindToBrushConverter}}"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                     Fill="{Binding Kind, Converter={StaticResource PathKindToBrushConverter}}"/>
                                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Font.Hud}" FontSize="13.5" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Center: fields, chips, code panel -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Scenario.Premise}" FontFamily="{StaticResource Font.Body}" FontSize="13"
                                   Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FieldValueViewModel}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Field.Label}" FontFamily="{StaticResource Font.Code}" FontSize="11"
                                                   FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,10,8,0" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderInput}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextBody}"/>
                                                        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="Padding" Value="11,9"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock FontSize="11" Margin="2,3,0,0" Foreground="{DynamicResource Brush.TextMuted}"
                                                       Visibility="{Binding HasBaselineValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Run Text="Correct value: "/>
                                                <Run Text="{Binding BaselineValue, Mode=OneTime}" FontFamily="{StaticResource Font.Code}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Sample payload chips -->
                        <WrapPanel Margin="0,0,0,16">
                            <ItemsControl ItemsSource="{Binding Scenario.SamplePayloads}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,6" Padding="9,4" Cursor="Hand"
                                                Command="{Binding DataContext.FillPayloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderInput}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                    <Setter Property="FontFamily" Value="{StaticResource Font.Code}"/>
                                                    <Setter Property="FontSize" Value="11.5"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Mode=OneTime}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{} (normal)" Margin="0,0,6,6" Padding="9,4" Cursor="Hand"
                                    Command="{Binding FillBaselineCommand}"
                                    Visibility="{Binding HasBaseline, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderInput}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                        <Setter Property="FontFamily" Value="{StaticResource Font.Code}"/>
                                        <Setter Property="FontSize" Value="11.5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>

                        <!-- Code panel -->
                        <Border CornerRadius="12" Background="{DynamicResource Brush.CodeBg}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" ClipToBounds="True">
                            <StackPanel>
                                <Grid Background="{DynamicResource Brush.Bg1}">
                                    <StackPanel Orientation="Horizontal" Margin="10,8">
                                        <RadioButton x:Name="SqlTabButton" GroupName="MissionCodeLang" Content="SQL" Style="{StaticResource Button.NavItem}" IsChecked="True" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="CSharpTabButton" GroupName="MissionCodeLang" Content="C#" Style="{StaticResource Button.NavItem}" Margin="0,0,4,0"
                                                      Visibility="{Binding GeneratedCSharp, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                                        <RadioButton x:Name="PowerShellTabButton" GroupName="MissionCodeLang" Content="POWERSHELL" Style="{StaticResource Button.NavItem}"
                                                      Visibility="{Binding GeneratedPowerShell, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                               FontFamily="{StaticResource Font.Code}" FontSize="11" Foreground="#4A5066"
                                               Text="what SQL Server receives"/>
                                </Grid>

                                <!-- What the currently-selected fix still misses -->
                                <Border Padding="16,9" BorderThickness="0,1,0,0" BorderBrush="#1C2030" Background="#13FFB454"
                                        Visibility="{Binding CurrentFixGap, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                    <TextBlock FontFamily="{StaticResource Font.Body}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}">
                                        <Run Text="This fix doesn't cover: " FontWeight="Bold"/>
                                        <Run Text="{Binding CurrentFixGap, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>

                                <Grid MinHeight="130">
                                    <avalonEdit:TextEditor x:Name="SqlEditor" IsReadOnly="True" ShowLineNumbers="False" WordWrap="True"
                                                           FontFamily="{StaticResource Font.Code}" FontSize="12.5"
                                                           Background="Transparent" Foreground="{DynamicResource Brush.CodeText}" Padding="16,12"
                                                           Visibility="{Binding IsChecked, ElementName=SqlTabButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <avalonEdit:TextEditor x:Name="CSharpEditor" IsReadOnly="True" ShowLineNumbers="False" WordWrap="True"
                                                           FontFamily="{StaticResource Font.Code}" FontSize="12.5"
                                                           Background="Transparent" Foreground="{DynamicResource Brush.CodeText}" Padding="16,12"
                                                           Visibility="{Binding IsChecked, ElementName=CSharpTabButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <avalonEdit:TextEditor x:Name="PowerShellEditor" IsReadOnly="True" ShowLineNumbers="False" WordWrap="True"
                                                           FontFamily="{StaticResource Font.Code}" FontSize="12.5"
                                                           Background="Transparent" Foreground="{DynamicResource Brush.CodeText}" Padding="16,12"
                                                           Visibility="{Binding IsChecked, ElementName=PowerShellTabButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>

                                <!-- Runtime strip (C#/PowerShell only) -->
                                <Border Padding="16,9" BorderThickness="0,1,0,0" BorderBrush="#1C2030"
                                        Visibility="{Binding IsChecked, ElementName=SqlTabButton, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                    <StackPanel>
                                        <TextBlock Text="AT RUNTIME" FontFamily="{StaticResource Font.Code}" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FieldValueViewModel}">
                                                    <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="12" Margin="0,0,0,2">
                                                        <Run Text="{Binding Field.Key, Mode=OneTime}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                        <Run Text=" = &quot;"/>
                                                        <Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Brush.UserInputText}"/>
                                                        <Run Text="&quot;"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Verdict or Intel -->
                    <Grid Grid.Column="4">
                        <!-- Verdict column -->
                        <StackPanel Visibility="{Binding IsIntelOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                    behaviors:ImpactBehavior.Trigger="{Binding ResultVersion}"
                                    behaviors:ImpactBehavior.Severity="{Binding Result.Severity}">
                            <TextBlock Text="VERDICT" FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Result.Severity, Converter={StaticResource SeverityToTagConverter}}"
                                       FontFamily="{StaticResource Font.Hud}" FontSize="42" FontWeight="Bold"
                                       Foreground="{Binding Result.Severity, Converter={StaticResource SeverityToBrushConverter}}">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="30" Opacity="0.5"
                                                       Color="{Binding Result.Severity, Converter={StaticResource SeverityToBrushConverter}}"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding Result.Headline}" FontFamily="{StaticResource Font.Hud}" FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding Result.Detail}" FontFamily="{StaticResource Font.Body}" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="110"/>

                            <ItemsControl ItemsSource="{Binding Result.AffectedAssets}" Margin="0,10,0,0"
                                          Visibility="{Binding Result.AffectedAssets, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Code}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Critical}" Margin="0,1,0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,16,0,0" VerticalAlignment="Bottom"
                                        Visibility="{Binding Result.LeakedRows, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                <TextBlock Text="{Binding Result.RowCountLabel}" FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding Result.Severity, Converter={StaticResource SeverityToBrushConverter}}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Result.LeakedRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.CodeBg}" BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="0,0,0,4">
                                                <ItemsControl ItemsSource="{Binding}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="12" Margin="0,0,16,0">
                                                                <Run Text="{Binding Key, Mode=OneTime}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                                <Run Text="="/>
                                                                <Run Text="{Binding Value, Mode=OneTime}" Foreground="{DynamicResource Brush.Critical}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- Intel panel -->
                        <Border Visibility="{Binding IsIntelOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                CornerRadius="12" BorderThickness="1" BorderBrush="#1F3350" Background="#D90A101C">
                            <DockPanel>
                                <StackPanel x:Name="IntelTabsPanel" DockPanel.Dock="Top" Orientation="Horizontal">
                                    <RadioButton x:Name="IntelTabHow" GroupName="MissionIntelTab" Content="HOW IT WORKS" Style="{StaticResource IntelTab}" IsChecked="True"/>
                                    <RadioButton x:Name="IntelTabWhy" GroupName="MissionIntelTab" Content="WHY THE FIX" Style="{StaticResource IntelTab}"/>
                                    <RadioButton x:Name="IntelTabName" GroupName="MissionIntelTab" Content="THE NAME" Style="{StaticResource IntelTab}"/>
                                    <RadioButton x:Name="IntelTabSources" GroupName="MissionIntelTab" Content="SOURCES" Style="{StaticResource IntelTab}"/>
                                    <RadioButton x:Name="IntelTabNormal" GroupName="MissionIntelTab" Content="NORMAL USER" Style="{StaticResource IntelTab}"/>
                                </StackPanel>

                                <ScrollViewer Padding="20,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Scenario.HowItWorks}" FontFamily="{StaticResource Font.Body}" FontSize="14.5"
                                                   Foreground="{DynamicResource Brush.TextBody}" TextWrapping="Wrap" LineHeight="24"
                                                   Visibility="{Binding IsChecked, ElementName=IntelTabHow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Scenario.WhyTheFixWorks}" FontFamily="{StaticResource Font.Body}" FontSize="14.5"
                                                   Foreground="{DynamicResource Brush.TextBody}" TextWrapping="Wrap" LineHeight="24"
                                                   Visibility="{Binding IsChecked, ElementName=IntelTabWhy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Scenario.TerminologyNote}" FontFamily="{StaticResource Font.Body}" FontSize="14.5"
                                                   Foreground="{DynamicResource Brush.TextBody}" TextWrapping="Wrap" LineHeight="24"
                                                   Visibility="{Binding IsChecked, ElementName=IntelTabName, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <ItemsControl ItemsSource="{Binding Scenario.References}"
                                                      Visibility="{Binding IsChecked, ElementName=IntelTabSources, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#1F3350">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Url, Converter={StaticResource UrlToSourceKindConverter}}"
                                                                       FontFamily="{StaticResource Font.Code}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Hyperlink NavigateUri="{Binding Url, Mode=OneTime}" RequestNavigate="Hyperlink_RequestNavigate">
                                                                    <Run Text="{Binding Label, Mode=OneTime}" Foreground="#6FB2FF"/>
                                                                </Hyperlink>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Visibility="{Binding IsChecked, ElementName=IntelTabNormal, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="A NORMAL USER" FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding NormalResult.Headline}" FontFamily="{StaticResource Font.Hud}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{Binding NormalResult.Severity, Converter={StaticResource SeverityToBrushConverter}}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding NormalResult.Detail}" FontFamily="{StaticResource Font.Body}" FontSize="13"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>

                                        <TextBlock Margin="0,18,0,0" FontFamily="{StaticResource Font.Body}" FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                                                   Text="Every claim here is backed by an independently published source. Links open in your browser."/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Defense tiles -->
                <UniformGrid Margin="0,16,0,0" Columns="2" Rows="1">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMultipleFixes}" Value="True">
                                    <Setter Property="Columns" Value="3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <Button Margin="0,0,14,0" Command="{Binding SetFixIndexCommand}" CommandParameter="-1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DefenseTile}">
                                <Setter Property="BorderBrush" Value="#2B313F"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVulnerableSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Critical}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                        <Setter Property="Background" Value="#26FF2D55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="VULNERABLE" FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Critical}" Margin="0,0,0,8"/>
                                <TextBlock Text="No fix applied" FontFamily="{StaticResource Font.Hud}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="String concatenation" FontFamily="{StaticResource Font.Body}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Text="✓ ACTIVE" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="{StaticResource Font.Code}"
                                       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Critical}"
                                       Visibility="{Binding IsVulnerableSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>

                    <Button Margin="0,0,14,0" Command="{Binding SetFixIndexCommand}" CommandParameter="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DefenseTile}">
                                <Setter Property="BorderBrush" Value="{Binding Fixes[0].Grade, Converter={StaticResource GradeToBrushConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFix0Selected}" Value="True">
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                        <Setter Property="Background" Value="#26FFB454"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8"
                                           Foreground="{Binding Fixes[0].Grade, Converter={StaticResource GradeToBrushConverter}}">
                                    <Run Text="{Binding Fixes[0].Grade, Mode=OneTime}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Fixes[0].Label}" FontFamily="{StaticResource Font.Hud}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Fixes[0].Gap}" FontFamily="{StaticResource Font.Body}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="✓ ACTIVE" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="{StaticResource Font.Code}"
                                       FontSize="10" FontWeight="Bold" Foreground="{Binding Fixes[0].Grade, Converter={StaticResource GradeToBrushConverter}}"
                                       Visibility="{Binding IsFix0Selected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>

                    <Button Visibility="{Binding HasMultipleFixes, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding SetFixIndexCommand}" CommandParameter="1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DefenseTile}">
                                <Setter Property="BorderBrush" Value="{Binding Fixes[1].Grade, Converter={StaticResource GradeToBrushConverter}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFix1Selected}" Value="True">
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                        <Setter Property="Background" Value="#263DD68C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8"
                                           Foreground="{Binding Fixes[1].Grade, Converter={StaticResource GradeToBrushConverter}}">
                                    <Run Text="{Binding Fixes[1].Grade, Mode=OneTime}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Fixes[1].Label}" FontFamily="{StaticResource Font.Hud}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Fixes[1].Gap}" FontFamily="{StaticResource Font.Body}" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="✓ ACTIVE" HorizontalAlignment="Right" VerticalAlignment="Top" FontFamily="{StaticResource Font.Code}"
                                       FontSize="10" FontWeight="Bold" Foreground="{Binding Fixes[1].Grade, Converter={StaticResource GradeToBrushConverter}}"
                                       Visibility="{Binding IsFix1Selected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                </UniformGrid>

            </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>

        <!-- ================= TRAINING (2e, replaces the modal TutorialWindow) ================= -->
        <Grid Grid.Row="3" Visibility="{Binding IsTraining, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid DataContext="{Binding Tutorial}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Step bar -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding StepRows}" Margin="30,22,30,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="9" Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TutorialStepRow}">
                        <Button Margin="0,0,6,0" Padding="10,9" Cursor="Hand" HorizontalContentAlignment="Left"
                                Command="{Binding DataContext.SetStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Index}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#141724"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                            <Setter Property="Background" Value="#2A2F44"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextBody}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.GradientCta}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <Grid>
                                    <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold" Opacity="0.85">
                                        <Run Text="{Binding DisplayNumber, Mode=OneWay, StringFormat='{}{0:00}'}"/>
                                    </TextBlock>
                                    <TextBlock Text="LIVE" HorizontalAlignment="Right" FontFamily="{StaticResource Font.Code}" FontSize="9"
                                               FontWeight="Bold" Opacity="0.85"
                                               Visibility="{Binding HasDemo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                                <TextBlock Text="{Binding Step.Title, Converter={StaticResource TutorialShortTitleConverter}}"
                                           FontFamily="{StaticResource Font.Hud}" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="30,22,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="11" FontWeight="Bold" Foreground="#C29BFF" Margin="0,0,0,8">
                            <Run Text="STEP "/><Run Text="{Binding StepNumber, Mode=OneWay}"/><Run Text=" OF "/><Run Text="{Binding StepCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentStep.Title}" FontFamily="{StaticResource Font.Hud}" FontSize="30" FontWeight="Bold"
                                   TextWrapping="Wrap" LineHeight="34"/>
                        <ItemsControl ItemsSource="{Binding CurrentStep.Paragraphs}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Body}" FontSize="15"
                                               Foreground="{DynamicResource Brush.TextBody}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="24"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <!-- With a demo -->
                    <StackPanel Visibility="{Binding HasDemo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border CornerRadius="16" Padding="22" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="#D90A0C12">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.NeonRedLabel}" Margin="0,0,0,10">
                                    <Run Text="LIVE DEMO · "/><Run Text="{Binding DemoFieldLabel, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBox Text="{Binding DemoInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}"
                                         FontSize="18" Padding="14,11">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="#0FFF2D55"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.NeonRed}"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.NeonRedLight}"/>
                                            <Setter Property="CaretBrush" Value="{DynamicResource Brush.NeonRedLight}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="{Binding DemoHint}" FontFamily="{StaticResource Font.Body}" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding DemoHint, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                                <Border Background="#05060A" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                                    <TextBlock Text="{Binding DemoSql}" FontFamily="{StaticResource Font.Code}" FontSize="14"
                                               Foreground="{DynamicResource Brush.CodeText}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" CornerRadius="14" Padding="18,16" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter Property="Background" Value="#0F5AA7FF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DemoIsDangerous}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Critical}"/>
                                            <Setter Property="Background" Value="#17FF2D55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource Font.Hud}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ALL NORMAL"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DemoIsDangerous}" Value="True">
                                                    <Setter Property="Text" Value="THAT BROKE IT"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DemoExplain}" FontFamily="{StaticResource Font.Body}" FontSize="13.5"
                                           Foreground="{DynamicResource Brush.TextBody}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Without a demo: mascot -->
                    <Image Source="Resources/Branding/AppIcon.png" Width="360" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasDemo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="30,18,30,22">
                <Button Content="← BACK" HorizontalAlignment="Left" Padding="22,12" Command="{Binding BackCommand}"
                        IsEnabled="{Binding CanGoBack}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="Reopen any time from Training. Nothing here touches a real database." HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontFamily="{StaticResource Font.Body}" FontSize="12.5"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Content="{Binding NextButtonLabel}" Style="{StaticResource Button.GradientCta}" Padding="22,12"
                        HorizontalAlignment="Right" Command="{Binding NextCommand}"/>
            </Grid>
        </Grid>
        </Grid>
        <!-- ================= QUIZ (2f in-progress / 2g debrief, replaces the modal QuizWindow) ================= -->
        <Grid Grid.Row="3" Visibility="{Binding IsQuiz, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid DataContext="{Binding Quiz}">

            <!-- 2f: in-progress -->
            <Grid Margin="26,22,26,24" Visibility="{Binding IsSessionComplete, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.NeonRedLabel}" VerticalAlignment="Center">
                            <Run Text="QUESTION "/><Run Text="{Binding QuestionNumber, Mode=OneWay, StringFormat='{}{0:00}'}"/>
                            <Run Text=" / "/><Run Text="{Binding QuestionCount, Mode=OneWay, StringFormat='{}{0:00}'}"/>
                        </TextBlock>
                        <Border HorizontalAlignment="Right" CornerRadius="9" Padding="3" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="BEGINNER" Style="{StaticResource Button.Segment}"
                                              IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Beginner, Mode=OneWay}"
                                              Command="{Binding SetDifficultyCommand}" CommandParameter="Beginner"/>
                                <ToggleButton Content="INTERMEDIATE" Style="{StaticResource Button.Segment}"
                                              IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Intermediate, Mode=OneWay}"
                                              Command="{Binding SetDifficultyCommand}" CommandParameter="Intermediate"/>
                                <ToggleButton Content="EXPERT" Style="{StaticResource Button.Segment}"
                                              IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Expert, Mode=OneWay}"
                                              Command="{Binding SetDifficultyCommand}" CommandParameter="Expert"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Briefing -->
                    <StackPanel MinHeight="96" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowTitleAndCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding CurrentQuestion.Title}" FontFamily="{StaticResource Font.Hud}" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentQuestion.Category, Converter={StaticResource CategoryDisplayConverter}}" FontFamily="{StaticResource Font.Code}"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Bottom" Margin="12,0,0,2"/>
                        </StackPanel>
                        <TextBlock Text="██████ ████████" FontFamily="{StaticResource Font.Hud}" FontSize="26" FontWeight="Bold" Foreground="#4A5066"
                                   Visibility="{Binding ShowTitleAndCategory, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <TextBlock Text="{Binding CurrentQuestion.Premise}" FontFamily="{StaticResource Font.Body}" FontSize="14.5"
                                   Foreground="#AEB5C3" TextWrapping="Wrap" MaxWidth="720" Margin="0,8,0,0"
                                   Visibility="{Binding ShowPremise, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="No briefing at Expert. Work out what's wrong from the form alone." FontFamily="{StaticResource Font.Body}"
                                   FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" FontStyle="Italic" Margin="0,8,0,0"
                                   Visibility="{Binding ShowPremise, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                        <StackPanel Visibility="{Binding ShowGoalAndHints, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,10,0,0">
                            <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Warning}" Text="GOAL"/>
                            <TextBlock Text="{Binding CurrentQuestion.ChallengeGoal}" FontFamily="{StaticResource Font.Body}" FontSize="13.5"
                                       Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <ItemsControl ItemsSource="{Binding CurrentQuestion.Hints}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource Font.Body}" FontSize="12.5" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,2">
                                            <Run Text="Hint: " FontWeight="Bold"/><Run Text="{Binding Mode=OneTime}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Form card -->
                    <Border CornerRadius="14" Padding="18,20" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Bg1}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentQuestion.MockAppLabel}" FontFamily="{StaticResource Font.Body}" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FieldValueViewModel}">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Field.Label}" FontFamily="{StaticResource Font.Code}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.NeonRedLabel}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Code}"
                                                         FontSize="16" Padding="12,10">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Background" Value="#0FFF2D55"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.NeonRed}"/>
                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.NeonRedLight}"/>
                                                            <Setter Property="CaretBrush" Value="{DynamicResource Brush.NeonRedLight}"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="SUBMIT" Style="{StaticResource Button.GradientCta}" HorizontalAlignment="Left" Padding="24,10"
                                    Command="{Binding SubmitCommand}" Margin="0,4,0,14"/>

                            <Border CornerRadius="10" Background="{DynamicResource Brush.CodeBg}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="10,8">
                                        <RadioButton x:Name="QuizSqlTab" GroupName="QuizCodeLang" Content="SQL" Style="{StaticResource Button.NavItem}" IsChecked="True" Margin="0,0,4,0"/>
                                        <RadioButton x:Name="QuizCSharpTab" GroupName="QuizCodeLang" Content="C#" Style="{StaticResource Button.NavItem}" Margin="0,0,4,0"
                                                      Visibility="{Binding GeneratedCSharp, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                                        <RadioButton x:Name="QuizPowerShellTab" GroupName="QuizCodeLang" Content="POWERSHELL" Style="{StaticResource Button.NavItem}"
                                                      Visibility="{Binding GeneratedPowerShell, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GeneratedSql}" FontFamily="{StaticResource Font.Code}" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.CodeText}" TextWrapping="Wrap" Padding="16,4,16,16"
                                               Visibility="{Binding IsChecked, ElementName=QuizSqlTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding GeneratedCSharp}" FontFamily="{StaticResource Font.Code}" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.CodeText}" TextWrapping="Wrap" Padding="16,4,16,16"
                                               Visibility="{Binding IsChecked, ElementName=QuizCSharpTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding GeneratedPowerShell}" FontFamily="{StaticResource Font.Code}" FontSize="12.5"
                                               Foreground="{DynamicResource Brush.CodeText}" TextWrapping="Wrap" Padding="16,4,16,16"
                                               Visibility="{Binding IsChecked, ElementName=QuizPowerShellTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Outcome card -->
                    <Border Margin="0,16,0,0" CornerRadius="14" Padding="20,22" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                        <Grid>
                            <StackPanel Visibility="{Binding HasSubmittedCurrent, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock FontFamily="{StaticResource Font.Hud}" FontSize="36" FontWeight="Bold" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="NOT YET"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentSolved}" Value="True">
                                                    <Setter Property="Text" Value="SOLVED"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Blocked}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding OutcomeHeadline}" FontFamily="{StaticResource Font.Hud}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OutcomeDetail}" FontFamily="{StaticResource Font.Body}" FontSize="13"
                                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Edit the payload, then Submit to lock it in." FontFamily="{StaticResource Font.Body}" FontSize="13"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Visibility="{Binding HasSubmittedCurrent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <!-- THIS RUN sidebar -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="THIS RUN" FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuizQuestionResult}">
                                <Border CornerRadius="10" Padding="14,11" Margin="0,0,0,6" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderSubtle}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.NeonRed}"/>
                                                    <Setter Property="Background" Value="#14FF2D55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number, StringFormat='{}{0:00}'}" FontFamily="{StaticResource Font.Code}"
                                                   FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Scenario.Title}" FontFamily="{StaticResource Font.Hud}" FontSize="12"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Visibility="{Binding Answered, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="1" Text="— classified —" FontFamily="{StaticResource Font.Hud}" FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"
                                                   Visibility="{Binding Answered, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                        <TextBlock Grid.Column="2" FontSize="13" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="·"/>
                                                    <Setter Property="Foreground" Value="#4A5066"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Text" Value="▶"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.UserInputText}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Answered}" Value="True">
                                                            <Setter Property="Text" Value="✕"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Answered}" Value="True"/>
                                                                <Condition Binding="{Binding Solved}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="✓"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blocked}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="NEXT QUESTION →" Style="{StaticResource Button.OutlineBlue}" Padding="18,10" Margin="0,10,0,6"
                            HorizontalAlignment="Stretch" Command="{Binding NextQuestionCommand}"/>
                    <TextBlock Text="Next always advances, solved or not." FontFamily="{StaticResource Font.Body}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- 2g: debrief -->
            <Grid Margin="34,40" Visibility="{Binding IsSessionComplete, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Resources/Branding/AppIcon.png" Width="240" Height="240" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Font.Code}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,10">
                        <Run Text="QUIZ COMPLETE · "/><Run Text="{Binding Difficulty, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Font.Hud}" FontSize="72" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.GradientWordmark}">
                        <Run Text="{Binding Score, Mode=OneWay}"/><Run Text=" / 6"/>
                    </TextBlock>
                    <TextBlock Text="MISSIONS CRACKED" HorizontalAlignment="Center" FontFamily="{StaticResource Font.Hud}" FontSize="16"
                               FontWeight="Bold" Margin="0,4,0,18"/>
                    <TextBlock Text="Try Expert next: no title, no premise, no goal. Recognizing the technique is the test."
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320" FontFamily="{StaticResource Font.Body}" FontSize="13"
                               Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Difficulty}" Value="Expert">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="NEW QUIZ" Style="{StaticResource Button.GradientCta}" Padding="22,12" Margin="0,0,12,0"
                                Command="{Binding StartSessionCommand}"/>
                        <Button Content="TRY EXPERT" Style="{StaticResource Button.OutlineBlue}" Padding="22,12"
                                Command="{Binding SetDifficultyCommand}" CommandParameter="Expert"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="DEBRIEF" FontFamily="{StaticResource Font.Code}" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuizQuestionResult}">
                                <Border CornerRadius="12" Padding="16,13" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#1F2433">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number, StringFormat='{}{0:00}'}" FontFamily="{StaticResource Font.Code}"
                                                   FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Scenario.Title}" FontFamily="{StaticResource Font.Hud}" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Scenario.Category, Converter={StaticResource CategoryDisplayConverter}}"
                                                           FontFamily="{StaticResource Font.Code}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                                                           VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastPayload}" FontFamily="{StaticResource Font.Code}" FontSize="12"
                                                       Foreground="{DynamicResource Brush.UserInputText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" HorizontalAlignment="Right" CornerRadius="5" Padding="9,4" Background="#1AFF5C6C">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Solved}" Value="True">
                                                            <Setter Property="Background" Value="#1A3DD68C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="10.5" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="MISSED"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Solved}" Value="True">
                                                                <Setter Property="Text" Value="CRACKED"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Blocked}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,8,0,0">
                        <Hyperlink Click="OpenMissedMissions_Click" Foreground="#6FB2FF">
                            <Run Text="Open the "/><Run Text="{Binding MissedCount, Mode=OneWay}"/><Run Text=" missed missions in Mission select →"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>
