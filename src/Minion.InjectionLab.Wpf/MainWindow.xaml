<Window x:Class="Minion.InjectionLab.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minion.InjectionLab.Wpf"
        xmlns:vm="clr-namespace:Minion.InjectionLab.Wpf.ViewModels"
        xmlns:behaviors="clr-namespace:Minion.InjectionLab.Wpf.Behaviors"
        xmlns:core="clr-namespace:Minion.InjectionLab.Core.Models;assembly=Minion.InjectionLab.Core"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Style="{StaticResource BaseWindowStyle}"
        Title="Minion.InjectionLab" Height="900" Width="1420" MinHeight="680" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        Icon="Resources/Branding/AppIcon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= MENU BAR ================= -->
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Bg1}"
              Foreground="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle theme" Command="{Binding ToggleThemeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Feature list" Click="HelpButton_Click"/>
                <MenuItem Header="Show tutorial" Click="TutorialButton_Click"/>
                <Separator/>
                <MenuItem Header="About Minion.InjectionLab" Click="AboutMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Minionware">
                <MenuItem Header="minionware.net" Click="MinionwareLogo_Click"/>
                <MenuItem Header="Other products (coming soon)" IsEnabled="False"/>
            </MenuItem>
        </Menu>

        <!-- ================= LEFT NAV ================= -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Brush.Bg1}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,10">
                    <Button HorizontalAlignment="Left" Margin="0,0,0,14" Padding="0" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="minionware.net" Click="MinionwareLogo_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="Resources/Branding/MinionwareWordmark.png" Stretch="Uniform" Height="20"/>
                    </Button>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Brush.Bg2}" Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="Resources/Branding/AppIcon.png" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Minion.InjectionLab" Style="{StaticResource Text.H1}" FontSize="16"/>
                            <TextBlock Text="SQL injection, attack by attack" Style="{StaticResource Text.Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="🌓  Toggle theme" Margin="0,14,0,0" HorizontalAlignment="Stretch"
                            Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left"
                            Command="{Binding ToggleThemeCommand}"/>
                    <Button Content="🎓  Tutorial" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                            Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left"
                            Click="TutorialButton_Click"/>
                    <Button Content="❓  Help" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                            Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left"
                            Click="HelpButton_Click" ToolTip="Opens the feature list (help/index.md) — the full in-app help viewer is coming later"/>

                    <StackPanel Orientation="Horizontal" Margin="2,16,0,6">
                        <TextBlock Text="DIFFICULTY" Style="{StaticResource Text.Muted}" FontWeight="Bold"/>
                        <TextBlock Text="ⓘ" Margin="5,0,0,0" Cursor="Help" Foreground="{DynamicResource Brush.TextMuted}"
                                   ToolTip="Changes how forgiving the weak 'Partial' fixes are at catching an attack — Beginner lets obvious attempts through easily, Expert makes you work harder to find the gap. It never changes which techniques exist, only how easily the naive fix catches them."/>
                    </StackPanel>
                    <Border Background="{DynamicResource Brush.Bg2}" CornerRadius="16" Padding="3">
                        <UniformGrid Columns="3">
                            <ToggleButton Content="Beginner" Style="{StaticResource Button.Segment}"
                                          IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Beginner, Mode=OneWay}"
                                          Command="{Binding SetDifficultyCommand}" CommandParameter="Beginner"/>
                            <ToggleButton Content="Intermediate" Style="{StaticResource Button.Segment}"
                                          IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Intermediate, Mode=OneWay}"
                                          Command="{Binding SetDifficultyCommand}" CommandParameter="Intermediate"/>
                            <ToggleButton Content="Expert" Style="{StaticResource Button.Segment}"
                                          IsChecked="{Binding Difficulty, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Expert, Mode=OneWay}"
                                          Command="{Binding SetDifficultyCommand}" CommandParameter="Expert"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <ListBox x:Name="AttacksList" DockPanel.Dock="Top"
                         Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Attacks}"
                         SelectedItem="{Binding SelectedAttack}"
                         ItemContainerStyle="{StaticResource AttackListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AttackViewModel}">
                            <TextBlock Text="{Binding Scenario.Title}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Muted}" FontWeight="Bold"
                                               FontSize="11" Margin="10,14,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= WELCOME SCREEN ================= -->
        <!-- Spans BOTH columns and sits above the left-nav Border in z-order, so it genuinely
             blocks picking a scenario from the list underneath — not just the content area.
             DataContext here is still the MainViewModel (nothing below overrides it). -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding HasSelectedAttack, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource Color.Bg0}" Offset="0"/>
                    <GradientStop Color="{DynamicResource Color.Bg1}" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <Grid HorizontalAlignment="Center" Width="220" Height="220"
                      RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Grid.RenderTransform>
                        <ScaleTransform ScaleX="0.4" ScaleY="0.4"/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.65">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.65">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>

                    <Ellipse Width="220" Height="220" Fill="{DynamicResource Brush.Accent}" Opacity="0.22">
                        <Ellipse.Effect>
                            <BlurEffect Radius="50"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Image Source="Resources/Branding/AppIcon.png" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Opacity="0.45"/>
                        </Image.Effect>
                    </Image>
                </Grid>

                <TextBlock Text="FROM" Style="{StaticResource Text.Muted}" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,30,0,10"/>
                <Button HorizontalAlignment="Center" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="minionware.net" Click="MinionwareLogo_Click"
                        RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Button.RenderTransform>
                        <ScaleTransform ScaleX="0.3" ScaleY="0.3"/>
                    </Button.RenderTransform>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5" BeginTime="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.7" BeginTime="0:0:0.15">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.7" BeginTime="0:0:0.15">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter/>
                        </ControlTemplate>
                    </Button.Template>
                    <Image Source="Resources/Branding/MinionwareWordmark.png" Stretch="Uniform" Height="68"/>
                </Button>

                <StackPanel Opacity="0">
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.6" BeginTime="0:0:0.35"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <TextBlock Text="Minion.InjectionLab" Style="{StaticResource Text.H1}" FontSize="36" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,26,0,6"/>
                    <TextBlock Text="SQL injection, attack by attack — see exactly how, and exactly why the fix works."
                               Style="{StaticResource Text.Muted}" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,28,0,0" BorderBrush="{DynamicResource Brush.Blocked}" BorderThickness="1.5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Brush.Blocked}" Margin="0,0,10,0">
                                <TextBlock Text="🛡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="This app never touches a real database" Style="{StaticResource Text.H2}" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap">
                            It never opens a database connection and never executes anything. Every query, every
                            result, every "leaked row" is a string this app built and a rule-based narration of
                            what a real SQL Server engine would do with it — safe to run anywhere, with nothing
                            to break and nothing to point at something real.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" Style="{StaticResource Text.Muted}" FontSize="12">
                    <Run Text="{Binding AttackCount, Mode=OneWay}"/><Run Text=" attacks · 6 categories · SQL, C#, and PowerShell, every time"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="🎓  Start the tutorial" Style="{StaticResource Button.Primary}" Padding="20,11" Margin="0,0,10,0"
                            FontSize="13" Click="TutorialButton_Click"/>
                    <Button Content="📂  Browse the attack catalog" Padding="20,11" FontSize="13"
                            Command="{Binding BrowseCatalogCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= RIGHT CONTENT (a scenario is selected) ================= -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSelectedAttack, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Margin="28,24,28,32" DataContext="{Binding SelectedAttack}">

                <!-- Header -->
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Scenario.Title}" Style="{StaticResource Text.H1}"/>
                        <TextBlock Text="{Binding Scenario.Premise}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button Content="↺  Reset scenario" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding ResetScenarioCommand}"/>
                </Grid>

                <!-- Controls row -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Single-fix scenarios: the simple on/off switch (multi-fix scenarios compare
                             fixes down in the "What actually runs" code box instead — see below) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,32,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasMultipleFixes, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsFixApplied}" VerticalAlignment="Center"/>
                            <TextBlock Text="Apply the fix" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsChallengeMode}" VerticalAlignment="Center"/>
                            <TextBlock Text="Try it yourself" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Challenge panel -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                        Visibility="{Binding IsChallengeMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Challenge" Style="{StaticResource Text.H2}"/>
                        <TextBlock Text="{Binding Scenario.ChallengeGoal}" Style="{StaticResource Text.Body}"/>

                        <ItemsControl ItemsSource="{Binding RevealedHints}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,2">
                                        <Run Text="Hint: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding Mode=OneTime}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding IsAnswerRevealed, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Answer: " FontWeight="SemiBold" Style="{StaticResource Text.Body}" VerticalAlignment="Top"/>
                            <TextBox Text="{Binding Scenario.ChallengeAnswer, Mode=OneTime}" Style="{StaticResource TextBox.Selectable}"
                                     FontFamily="{StaticResource Font.Code}" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="💡 Give me a hint" Style="{StaticResource Button.Primary}" Margin="0,0,8,0"
                                    Command="{Binding RevealNextHintCommand}"
                                    IsEnabled="{Binding HasMoreHints}"/>
                            <Button Content="Show the answer" Margin="0,0,8,0"
                                    Command="{Binding RevealAnswerCommand}"
                                    IsEnabled="{Binding CanRevealAnswer}"
                                    ToolTip="Not available on Expert — you have to crack it yourself"/>
                            <Button Content="Reset" Command="{Binding ResetChallengeCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Main column (form, then code — full width) + slim sidebar (decision paths, sample payloads) -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Live mock app preview -->
                        <Border CornerRadius="10" Background="{DynamicResource Brush.Bg2}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <Border Background="{DynamicResource Brush.Bg0}" CornerRadius="10,10,0,0" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="#FF5F57" Margin="0,0,6,0"/>
                                        <Ellipse Width="10" Height="10" Fill="#FEBC2E" Margin="0,0,6,0"/>
                                        <Ellipse Width="10" Height="10" Fill="#28C840" Margin="0,0,14,0"/>
                                        <TextBlock Text="{Binding Scenario.MockAppLabel}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="20">
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FieldValueViewModel}">
                                                <StackPanel Margin="0,0,0,10" MaxWidth="360" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Field.Label}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                                                    <TextBox Style="{StaticResource TextBox.Field}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock FontSize="11" Margin="2,3,0,0" Foreground="{DynamicResource Brush.TextMuted}"
                                                               Visibility="{Binding HasBaselineValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Run Text="Correct value: "/>
                                                        <Run Text="{Binding BaselineValue, Mode=OneTime}" FontFamily="{StaticResource Font.Code}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="▶  Submit" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Padding="22,9"
                                            FontSize="14" Command="{Binding SubmitCommand}" Margin="0,6,0,0"/>

                                    <Border Margin="0,16,0,0" CornerRadius="8" Padding="14" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                            Visibility="{Binding HasSubmitted, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <TextBlock Text="Fill in the form above and hit Submit to see what the server actually does with it." Style="{StaticResource Text.Muted}"/>
                                    </Border>

                                    <!-- After Submit: normal user vs. you -->
                                    <Grid Margin="0,16,0,0" Visibility="{Binding HasSubmitted, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="8" Padding="14" Background="{DynamicResource Brush.Bg1}" BorderThickness="1"
                                                Visibility="{Binding HasBaseline, Converter={StaticResource BoolToVisibilityConverter}}"
                                                behaviors:ImpactBehavior.Trigger="{Binding ResultVersion}"
                                                behaviors:ImpactBehavior.Severity="{Binding NormalResult.Severity}">
                                            <Border.BorderBrush><SolidColorBrush Color="{DynamicResource Color.Border}"/></Border.BorderBrush>
                                            <StackPanel>
                                                <TextBlock Text="A NORMAL USER" Style="{StaticResource Text.Muted}" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding NormalResult.Severity, Converter={StaticResource SeverityToIconConverter}}" FontSize="20" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding NormalResult.Headline}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{Binding NormalResult.Severity, Converter={StaticResource SeverityToBrushConverter}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding NormalResult.Detail}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>

                                                <Button Content="{Binding NormalResult.RowCountLabel, StringFormat='👁 View results ({0})'}"
                                                        Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Padding="0" Margin="0,8,0,0" FontSize="11"
                                                        Command="{Binding ToggleNormalResultRowsCommand}"
                                                        Visibility="{Binding NormalResult.LeakedRows, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                                                <ItemsControl ItemsSource="{Binding NormalResult.LeakedRows}" Margin="0,8,0,0"
                                                              Visibility="{Binding ShowNormalResultRows, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource Brush.CodeBg}" BorderBrush="{DynamicResource Brush.Border}"
                                                                    BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2,0,2">
                                                                <ItemsControl ItemsSource="{Binding}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="11" Margin="0,0,16,0">
                                                                                <Run Text="{Binding Key, Mode=OneTime}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                                                <Run Text="="/>
                                                                                <Run Text="{Binding Value, Mode=OneTime}" Foreground="{DynamicResource Brush.Accent}"/>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" CornerRadius="8" Padding="14" Background="{DynamicResource Brush.Bg1}" BorderThickness="1"
                                                behaviors:ImpactBehavior.Trigger="{Binding ResultVersion}"
                                                behaviors:ImpactBehavior.Severity="{Binding Result.Severity}">
                                            <Border.BorderBrush><SolidColorBrush Color="{DynamicResource Color.Border}"/></Border.BorderBrush>
                                            <StackPanel>
                                                <TextBlock Text="YOU" Style="{StaticResource Text.Muted}" FontWeight="Bold" Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Result.Severity, Converter={StaticResource SeverityToIconConverter}}" FontSize="20" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Result.Headline}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{Binding Result.Severity, Converter={StaticResource SeverityToBrushConverter}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Result.Detail}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>

                                                <!-- Compound-attack groundwork: blast radius + leaked data preview (hidden unless a scenario sets them) -->
                                                <ItemsControl ItemsSource="{Binding Result.AffectedAssets}" Margin="0,10,0,0"
                                                              Visibility="{Binding Result.AffectedAssets, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" FontFamily="{StaticResource Font.Code}"
                                                                       Foreground="{DynamicResource Brush.Critical}" Margin="0,1,0,1"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Button Content="{Binding Result.RowCountLabel, StringFormat='👁 View results ({0})'}"
                                                        Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Padding="0" Margin="0,8,0,0" FontSize="11"
                                                        Command="{Binding ToggleResultRowsCommand}"
                                                        Visibility="{Binding Result.LeakedRows, Converter={StaticResource NotEmptyToVisibilityConverter}}"/>
                                                <ItemsControl ItemsSource="{Binding Result.LeakedRows}" Margin="0,8,0,0"
                                                              Visibility="{Binding ShowResultRows, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource Brush.CodeBg}" BorderBrush="{DynamicResource Brush.Border}"
                                                                    BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2,0,2">
                                                                <ItemsControl ItemsSource="{Binding}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock FontFamily="{StaticResource Font.Code}" FontSize="11" Margin="0,0,16,0">
                                                                                <Run Text="{Binding Key, Mode=OneTime}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                                                <Run Text="="/>
                                                                                <Run Text="{Binding Value, Mode=OneTime}" Foreground="{DynamicResource Brush.Critical}"/>
                                                                            </TextBlock>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="This is what the end user sees." Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Code tabs: SQL / C# / PowerShell — live, no Submit needed, full width right under the form -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="What actually runs" Style="{StaticResource Text.H2}"/>
                                        <TextBlock Text="ⓘ" Margin="6,0,0,0" Cursor="Help" Foreground="{DynamicResource Brush.TextMuted}"
                                                   ToolTip="Switch between Vulnerable and each graded fix using the tabs below — red/amber/green shows how good that fix really is. SQL, C# and PowerShell tabs below that all show the same logic in each language."/>
                                    </StackPanel>
                                    <Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.AccentMuted}"
                                            Visibility="{Binding HasMultipleFixes, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="VULNERABLE"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFixApplied}" Value="True">
                                                            <Setter Property="Text" Value="FIX APPLIED"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Blocked}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Multi-fix scenarios: a real tab per variant — Vulnerable, then each graded fix -->
                                <TabControl Margin="0,10,0,0" Padding="0"
                                            Visibility="{Binding HasMultipleFixes, Converter={StaticResource BoolToVisibilityConverter}}"
                                            SelectedIndex="{Binding CurrentFixIndex, Converter={StaticResource FixTabIndexConverter}}">
                                    <TabItem Header="⚠ Vulnerable" Style="{StaticResource TabItem.Code.Vulnerable}"/>
                                    <TabItem Header="{Binding Fixes[0].Label}" Style="{Binding Fixes[0].Grade, Converter={StaticResource FixGradeToTabStyleConverter}}"/>
                                    <TabItem Header="{Binding Fixes[1].Label}" Style="{Binding Fixes[1].Grade, Converter={StaticResource FixGradeToTabStyleConverter}}"/>
                                </TabControl>

                                <!-- What the currently-selected fix still misses, if anything -->
                                <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource Brush.AccentMuted}"
                                        Visibility="{Binding CurrentFixGap, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}">
                                        <Run Text="⚠ This fix doesn't cover: " FontWeight="Bold"/>
                                        <Run Text="{Binding CurrentFixGap, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>

                                <TabControl Margin="0,10,0,0" MinHeight="220">
                                    <TabItem Header="SQL" Style="{StaticResource TabItem.Code}">
                                        <Border Style="{StaticResource CodeBlock}" Margin="0,10,0,0" Padding="0">
                                            <avalonEdit:TextEditor x:Name="SqlEditor" IsReadOnly="True" ShowLineNumbers="False"
                                                                   WordWrap="True" FontFamily="{StaticResource Font.Code}" FontSize="13"
                                                                   Background="Transparent" Foreground="{DynamicResource Brush.CodeText}" Padding="12"/>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="C#" Style="{StaticResource TabItem.Code}"
                                             Visibility="{Binding GeneratedCSharp, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                        <Border Style="{StaticResource CodeBlock}" Margin="0,10,0,0" Padding="0">
                                            <avalonEdit:TextEditor x:Name="CSharpEditor" IsReadOnly="True" ShowLineNumbers="False"
                                                                   WordWrap="True" FontFamily="{StaticResource Font.Code}" FontSize="13"
                                                                   Background="Transparent" Foreground="{DynamicResource Brush.CodeText}" Padding="12"/>
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="PowerShell" Style="{StaticResource TabItem.Code}"
                                             Visibility="{Binding GeneratedPowerShell, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                                        <Border Style="{StaticResource CodeBlock}" Margin="0,10,0,0" Padding="0">
                                            <avalonEdit:TextEditor x:Name="PowerShellEditor" IsReadOnly="True" ShowLineNumbers="False"
                                                                   WordWrap="True" FontFamily="{StaticResource Font.Code}" FontSize="13"
                                                                   Background="Transparent" Foreground="{DynamicResource Brush.CodeText}" Padding="12"/>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0" BorderThickness="1.4" BorderBrush="#E05CC9" Background="Transparent"/>
                                    <TextBlock Text="= dotted outline around exactly what came from the form above — live, as you type." Style="{StaticResource Text.Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sidebar: decision paths (compact) + sample payloads -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding HasDecisionPaths, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Where you're headed" Style="{StaticResource Text.H2}"/>
                                <TextBlock Text="Live, before you submit." Style="{StaticResource Text.Muted}" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Scenario.DecisionPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:DecisionPathDef}">
                                            <Border Margin="0,0,0,8" CornerRadius="7" Padding="10,8" BorderThickness="2">
                                                <Border.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Bg2}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource PathActiveConverter}">
                                                                        <Binding Path="Key"/>
                                                                        <Binding Path="DataContext.ActivePathKey" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="BorderBrush" Value="{Binding Kind, Converter={StaticResource PathKindToBrushConverter}}"/>
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Bg1}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Sample payloads -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Sample payloads" Style="{StaticResource Text.H2}"/>
                                <ItemsControl ItemsSource="{Binding Scenario.SamplePayloads}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Brush.Bg2}" CornerRadius="5" Padding="8,5" Margin="0,3,0,3">
                                                <TextBox Text="{Binding Mode=OneTime}" Style="{StaticResource TextBox.Selectable}"
                                                         FontFamily="{StaticResource Font.Code}" FontSize="11"
                                                         Foreground="{DynamicResource Brush.Accent}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- How it works / Why the fix works -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="How it works" Style="{StaticResource Text.H2}"/>
                            <TextBlock Text="{Binding Scenario.HowItWorks}" Style="{StaticResource Text.Body}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Why the fix works" Style="{StaticResource Text.H2}"/>
                            <TextBlock Text="{Binding Scenario.WhyTheFixWorks}" Style="{StaticResource Text.Body}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Terminology & further reading -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Where the name comes from" Style="{StaticResource Text.H2}"/>
                            <TextBlock Text="ⓘ" Margin="6,0,0,6" Cursor="Help" Foreground="{DynamicResource Brush.TextMuted}"
                                       ToolTip="Every attack here is checked against independent, external sources — OWASP, PortSwigger, Microsoft Learn, or the original academic literature — not just this app's own say-so. Click any link below to open it in your browser."/>
                        </StackPanel>
                        <TextBlock Text="{Binding Scenario.TerminologyNote}" Style="{StaticResource Text.Body}" Margin="0,0,0,10"/>

                        <TextBlock Text="Further reading" Style="{StaticResource Text.Muted}" FontWeight="Bold" Margin="0,4,0,4"/>
                        <ItemsControl ItemsSource="{Binding Scenario.References}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                                        <Run Text="🔗 "/>
                                        <Hyperlink NavigateUri="{Binding Url, Mode=OneTime}" RequestNavigate="Hyperlink_RequestNavigate">
                                            <Run Text="{Binding Label, Mode=OneTime}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
