<Application x:Class="Minion.InjectionLab.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Minion.InjectionLab.Wpf"
             xmlns:conv="clr-namespace:Minion.InjectionLab.Wpf.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Swap Colors.Dark.xaml for Colors.Light.xaml (or toggle at runtime) -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Brushes.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:EnumEqualsConverter x:Key="EnumEqualsConverter"/>
            <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter"/>
            <conv:SeverityToIconConverter x:Key="SeverityToIconConverter"/>
            <conv:FixTabIndexConverter x:Key="FixTabIndexConverter"/>
            <conv:PathKindToBrushConverter x:Key="PathKindToBrushConverter"/>
            <conv:PathActiveConverter x:Key="PathActiveConverter"/>
            <conv:FixGradeToTabStyleConverter x:Key="FixGradeToTabStyleConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
